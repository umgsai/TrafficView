[Unit]
Description=TrafficView metrics daemon
Documentation=file:///usr/share/doc/trafficview/dbus-v1.md
# 会话总线由 dbus-user-session 的 socket 拉起；Type=dbus 依赖该总线存在。
After=dbus.socket
Wants=dbus.socket

[Service]
Type=dbus
BusName=com.trafficview.Daemon1
ExecStart=/usr/bin/trafficviewd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
